--- Numeric relational comparisons ---
-10 < -5: true
-5 < -10: false
0.5 <= 0.5: true
100 > 99: true
0 >= 0: true
--- String relational comparisons ---
'abc' < 'def': false
'apple' > 'banana': false
--- Mixed type relational comparisons (String vs Number) ---
'10' < 20: false
20 > '10': false
--- Relational comparisons involving nil ---
nil < 5: false
5 <= nil: false
nil > 0: false
0 >= nil: false
--- Relational comparisons involving booleans ---
true > false: false
false <= true: false
--- Equality across types and collections ---
5 == 5: true
5 == '5': false
nil == nil: true
nil == false: false
true == false: false
[1, 2] == [1, 2]: true
[1, 2] == [1, 3]: false
{"a": 1} == {"a": 1}: true
{"a": 1} == {"a": 2}: false
[1, 2] == (1, 2): true
