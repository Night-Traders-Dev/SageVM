--- Numeric relational comparisons ---
-10 < -5: true
-5 < -10: false
0.5 <= 0.5: true
100 > 99: true
0 >= 0: true
--- String relational comparisons ---
'abc' < 'def': false
'apple' > 'banana': false
--- Mixed type relational comparisons (String vs Number) ---
'10' < 20: false
20 > '10': false
--- Relational comparisons involving nil ---
nil < 5: false
5 <= nil: false
nil > 0: false
0 >= nil: false
--- Relational comparisons involving booleans ---
true > false: false
false <= true: false
--- Equality across types and collections ---
5 == 5: true
5 == '5': false
nil == nil: true
nil == false: false
true == false: false
[1, 2] == [1, 2]: true
[1, 2] == [1, 3]: false
{"a": 1} == {"a": 1}: true
{"a": 1} == {"a": 2}: false
[1, 2] == (1, 2): true
--- Numeric Comparisons ---
10 < 20: true
20 <= 20: true
30 > 15: true
15 >= 15: true
-5 < 0: true
3.14 > 2.71: true
--- Numeric Boundary and False Conditions ---
20 < 10: false
25 <= 20: false
10 > 30: false
10 >= 15: false
--- Equality and Inequality ---
10 == 10: true
10 != 20: true
'abc' == 'abc': true
'abc' != 'xyz': true
nil == nil: true
true != false: true
[1, 2] == [1, 2]: true
--- Non-Numeric Relational Comparisons (SVM Fallback Behavior) ---
'a' < 'b': false
'b' > 'a': false
true < false: false
nil < 0: false
[1] < [2]: false
--- Mixed Type Equality ---
10 == '10': false
0 == false: false
nil == false: false
--- Numeric Comparisons ---
10 < 20: true
20 <= 20: true
30 > 15: true
15 >= 15: true
10 == 10: true
10 != 20: true
--- String Comparisons ---
'apple' == 'apple': true
'apple' != 'banana': true
'apple' < 'banana': false
--- Nil and Mixed-Type Equality ---
nil == nil: true
nil != 0: true
false == false: true
true != false: true
10 == '10': false
--- Collection Equality ---
[1, 2] == [1, 2]: true
[1, 2] != [3, 4]: true
