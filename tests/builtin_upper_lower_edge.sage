print "--- Upper / Lower Normal Strings ---"
print upper("hello world!")
print lower("HELLO WORLD!")
print upper("SageVM 2026")
print lower("SageVM 2026")

print "--- Upper / Lower Empty String ---"
print upper("")
print lower("")

print "--- Upper / Lower Non-String Inputs ---"
print upper(123)
print lower(456.78)
print upper(nil)
print lower(nil)
