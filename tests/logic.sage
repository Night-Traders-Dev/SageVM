# Logical NOT
print not true
print not false
print not nil
# print not 0
# print not "hi"

# Truthiness in if statements
if true:
    print "true is truthy"
if not false:
    print "false is falsy"
if nil:
    print "nil is truthy"
else:
    print "nil is falsy"
